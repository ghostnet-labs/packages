# dump978-fa: 978 MHz UAT receiver.
#
# The receiver is claimed ONLY by its RTL-SDR USB serial number, never by
# index, so the 1090 receiver (serial "1090", used by dump1090) and any
# scanner receivers are never opened by this service. Program the serial
# once with:  rtl_eeprom -d <index> -s 978   (then unplug and replug).

config dump978 'main'
	# 1 = start at boot. Off until a receiver with this serial is fitted.
	option enabled '0'
	# RTL-SDR USB serial to claim (exact match, see rtl_eeprom -s).
	option serial '978'
	# Tuner gain in dB; empty = maximum manual gain (upstream default),
	# 'auto' = tuner AGC.
	option gain ''
	# Frequency correction in ppm; empty = none.
	option ppm ''
	# Raw UAT frames for skyaware978 and other local consumers.
	# Loopback only: nothing is exposed on the mesh.
	option raw_port '127.0.0.1:30978'
	# Decoded JSON messages; empty = disabled.
	option json_port ''
	# Run skyaware978 to write aircraft.json (same layout as dump1090).
	option skyaware '1'
	option json_dir '/var/run/skyaware978'
