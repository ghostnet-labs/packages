config portal 'main'
	# 0 turns the setup prompt off: the node then never answers phones'
	# connectivity checks itself.
	option enabled '1'
	# Networks whose IPv4 addresses answer the checks. dnsmasq returns
	# the one on the phone's own subnet.
	list network 'ahwlan'
	list network 'lan'
	# Addresses pinged to decide whether the node has internet.
	list check_ip '1.1.1.1'
	list check_ip '8.8.8.8'
	list check_ip '9.9.9.9'
	# Seconds between internet checks.
	option interval '30'
	# openmanetd's plain-HTTP port, where /join lives.
	option join_port '8080'
