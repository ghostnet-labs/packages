#!/bin/sh /etc/rc.common

START=96
STOP=10
USE_PROCD=1

PROG=/usr/sbin/openmanet-phone-portal

start_service() {
	local enabled
	config_load openmanet_portal
	config_get_bool enabled main enabled 1
	if [ "$enabled" != 1 ]; then
		OPENMANET_PORTAL_LIB=1 . "$PROG"
		portal_clear
		return 0
	fi

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# Hand phones' checks back to the real internet when the service stops.
	OPENMANET_PORTAL_LIB=1 . "$PROG"
	portal_clear
}

service_triggers() {
	procd_add_reload_trigger openmanet_portal
}
