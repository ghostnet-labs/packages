#!/bin/sh

# Bind the bench node's battery monitor when its USB-I2C bridge appears.
# The Protectli box has no I2C header, so an Adafruit INA260 hangs off an
# Adafruit MCP2221A (hid-mcp2221) on a USB port. Each time an MCP2221 I2C
# adapter is added, declare an INA260 at 0x40 on it so the ina2xx hwmon
# driver binds; openmanetd's battery provider then finds it by name.

[ "$ACTION" = add ] || exit 0
# Only the adapter itself (".../i2c-N"), not clients on it (".../N-0040").
bus=${DEVPATH##*/}
case "$bus" in
i2c-[0-9]*) bus=${bus#i2c-} ;;
*) exit 0 ;;
esac

. /lib/functions.sh
. /usr/libexec/bsp-x86/board

[ -n "$(bsp_x86_role "$(board_name)")" ] || exit 0

adapter="/sys$DEVPATH"
grep -qs '^MCP2221' "$adapter/name" || exit 0

[ -e "/sys/bus/i2c/devices/$bus-0040" ] && exit 0

echo "ina260 0x40" > "$adapter/new_device" &&
	logger -t bsp-x86 "ina260 at 0x40 on i2c-$bus"

exit 0
