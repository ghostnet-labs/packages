#!/bin/sh

# The Protectli VP2430 bench node takes GNSS on its RS-232 COM port through a
# MAX3232: NMEA on RXD/TXD and the receiver's PPS on DCD. COM is a standard
# 16550 at 0x2F8, so it is /dev/ttyS1 (/dev/ttyS0 is the USB-C console).
# gpsd puts the tty into the pps-ldisc line discipline itself, which turns
# DCD edges into /dev/pps0, so one device argument covers NMEA and PPS.

. /lib/functions.sh
. /usr/libexec/bsp-x86/board

[ -n "$(bsp_x86_role "$(board_name)")" ] || exit 0

# Replace only the gpsd package default (/dev/ttyAMA0) or a USB GNSS
# default; leave an operator's own device choice alone.
case "$(uci -q get gpsd.core.device)" in
''|/dev/ttyAMA0|/dev/ttyUSB0|/dev/ttyACM0) ;;
*) exit 0 ;;
esac

uci set gpsd.core.device='/dev/ttyS1'
uci set gpsd.core.enabled='1'
uci commit gpsd

exit 0
