#!/bin/sh
. /lib/functions.sh
. /lib/functions/uci-defaults.sh

# Factory Wi-Fi defaults for the CM5 node and V1 (decision D-055 in the
# docs repo, GHO-89):
#   - 5 GHz: the access point for the user's EUD. SSID "openmanet",
#     fixed non-DFS channel 36 (so it comes up without a radar wait) at
#     low transmit power, because the EUD is worn right next to the node.
#   - 2.4 GHz: radio enabled so the batman-adv Wi-Fi backhaul is
#     available, but its AP is off. Keeping the AP off 2.4 GHz also
#     protects the GNSS margin.
#   - 6 GHz: radio off.
# The HaLow radio (type morse) is left to bsp-common's
# 99_morse_radio_defaults. UCI defaults run once, so an operator's later
# choices are never overwritten.
OPENMANET_AP_SSID="openmanet"
OPENMANET_AP_KEY="openmanet"
OPENMANET_AP_CHANNEL_5G=36
OPENMANET_AP_TXPOWER_5G=10
OPENMANET_CHANNEL_2G=6

setup_openmanet_wifi_radio() {
	local radio="$1"
	local type band iface="default_$1"

	config_get type "$radio" type
	[ "$type" = "morse" ] && return 0

	config_get band "$radio" band
	case "$band" in
	2g)
		uci set wireless."$radio".channel="$OPENMANET_CHANNEL_2G"
		uci set wireless."$radio".country="US"
		uci set wireless."$radio".disabled="0"
		uci -q get wireless."$iface" >/dev/null || return 0
		uci set wireless."$iface".ssid="${OPENMANET_AP_SSID}_2g"
		uci set wireless."$iface".encryption="psk2"
		uci set wireless."$iface".key="$OPENMANET_AP_KEY"
		uci set wireless."$iface".disabled="1"
		;;
	5g)
		uci set wireless."$radio".channel="$OPENMANET_AP_CHANNEL_5G"
		uci set wireless."$radio".country="US"
		uci set wireless."$radio".txpower="$OPENMANET_AP_TXPOWER_5G"
		uci set wireless."$radio".disabled="0"
		uci -q get wireless."$iface" >/dev/null || return 0
		uci set wireless."$iface".ssid="$OPENMANET_AP_SSID"
		uci set wireless."$iface".encryption="psk2"
		uci set wireless."$iface".key="$OPENMANET_AP_KEY"
		uci -q delete wireless."$iface".disabled
		;;
	6g)
		uci set wireless."$radio".disabled="1"
		;;
	esac
}

board=$(board_name)

board_config_update

case "$board" in
bcm2712,mm8108-usb|\
ghostnet,v1)
	config_load wireless
	config_foreach setup_openmanet_wifi_radio wifi-device
	uci -q commit wireless
	;;
esac

board_config_flush

exit 0
