#!/bin/sh /etc/rc.common

START=15

NAME=ina219-ups

# Declare the battery monitor to the kernel so its hwmon driver binds and
# battery voltage/current appear under /sys/class/hwmon. The CM5 boards have
# no devicetree node for it, so it is instantiated from /etc/config/ups:
# an INA219 (ina2xx driver) on the CM5 bench node, an INA228 (ina238
# driver) on the Ghostnet V1 carrier. Option 'chip' picks the device name.

log() {
	logger -t "$NAME" "$@"
}

# Print the number of the first i2c-gpio (bit-banged) adapter, if any.
gpio_bus() {
	local d

	for d in /sys/bus/i2c/devices/i2c-*; do
		grep -qs "i2c-gpio" "$d/of_node/compatible" || continue
		echo "${d##*/i2c-}"
		return 0
	done

	return 1
}

boot() {
	case "$(board_name)" in
	bcm2712,mm8108-usb|ghostnet,v1) ;;
	*) return 0 ;;
	esac

	start
}

start() {
	local enabled chip bus address shunt addr dev

	enabled=$(uci -q get ups.battery.enabled)
	[ "$enabled" = "0" ] && return 0

	chip=$(uci -q get ups.battery.chip)
	chip=${chip:-ina219}
	bus=$(uci -q get ups.battery.bus)
	address=$(uci -q get ups.battery.address)
	shunt=$(uci -q get ups.battery.shunt_uohm)
	[ -n "$bus" ] && [ -n "$address" ] || return 0

	if [ "$bus" = "gpio" ]; then
		bus=$(gpio_bus) || {
			log "no i2c-gpio adapter, $chip not configured"
			return 0
		}
	fi

	if [ ! -e "/sys/bus/i2c/devices/i2c-$bus/new_device" ]; then
		log "i2c-$bus not present, $chip not configured"
		return 0
	fi

	addr=$(printf '%04x' "$address")
	dev="/sys/bus/i2c/devices/$bus-$addr"

	if [ ! -e "$dev" ]; then
		echo "$chip $address" > "/sys/bus/i2c/devices/i2c-$bus/new_device" || {
			log "failed to add $chip at $address on i2c-$bus"
			return 0
		}
	fi

	if [ -n "$shunt" ]; then
		for f in "$dev"/shunt_resistor "$dev"/hwmon/hwmon*/shunt_resistor; do
			[ -w "$f" ] && echo "$shunt" > "$f"
		done
	fi

	log "$chip at $address on i2c-$bus"
}
