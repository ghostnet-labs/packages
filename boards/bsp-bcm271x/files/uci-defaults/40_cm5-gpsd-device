#!/bin/sh

# One CM5 image serves two bench carriers. The Waveshare CM5-DUAL-ETH-BASE
# brings GNSS NMEA in on header UART0 (/dev/ttyAMA0). The CM5-IO-WIRELESS-BASE
# has no 40-pin header, so its GNSS breakout reaches the node through a CH340
# USB-UART (/dev/ttyUSB0). Both are listed; gpsd drops whichever one is not
# present. PPS arrives on GPIO18 (/dev/pps0) on both, which gpsd does not pick
# up on its own for a plain tty, so it is listed too. /dev/pps0 goes first so
# it always takes SHM(0) (see /etc/ntpd.d/gps.conf).

. /lib/functions.sh

case "$(board_name)" in
bcm2712,mm8108-usb) ;;
*) exit 0 ;;
esac

case "$(uci -q get gpsd.core.device)" in
/dev/ttyAMA0|/dev/ttyUSB0|'/dev/pps0 /dev/ttyUSB0') ;;
*) exit 0 ;;
esac

uci set gpsd.core.device='/dev/pps0 /dev/ttyAMA0 /dev/ttyUSB0'
uci commit gpsd

exit 0
